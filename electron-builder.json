{
  "appId": "com.foxkafeteri.pos",
  "productName": "FOX Kafeteri",
  "directories": { "output": "release" },
  "files": ["dist/**/*", "dist-electron/main.cjs", "dist-electron/preload.cjs", "package.json", "!**/*.map", "!**/*.{sqlite,db,pfx,p12,pem,key,c,cc,h,hpp,pdb,lib,exp,ilk,gyp,gypi}", "!node_modules/better-sqlite3/deps/**/*", "!node_modules/better-sqlite3/src/**/*", "!node_modules/better-sqlite3/build/**/*", "!node_modules/better-sqlite3/prebuilds/darwin-*.node", "!node_modules/better-sqlite3/prebuilds/linux*.node", "!node_modules/better-sqlite3/prebuilds/win32-arm64.node", "!**/test_extension.node", "!**/.env*"],
  "asar": { "smartUnpack": false },
  "asarUnpack": ["node_modules/better-sqlite3/prebuilds/win32-x64.node"],
  "npmRebuild": true,
  "win": { "target": [{"target":"nsis","arch":["x64"]}], "artifactName": "FOX-Setup-${version}-${arch}.exe" },
  "nsis": { "oneClick": false, "perMachine": false, "allowElevation": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "deleteAppDataOnUninstall": false, "runAfterFinish": false },
  "publish": null
}
