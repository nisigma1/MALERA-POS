{
  "name": "fox-pos",
  "version": "0.7.1-rc.1",
  "private": true,
  "type": "module",
  "description": "FOX Kafeteri local desktop foundation",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild -f -w better-sqlite3",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "verify:checkout": "node scripts/verify-checkout.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "build:release": "npm run typecheck && vite build && node scripts/build-electron.mjs --release",
    "package:win": "node scripts/package-windows.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:installed": "node scripts/verify-installed.mjs",
    "release:sbom": "node scripts/supply-chain.mjs sbom",
    "release:scan": "node scripts/supply-chain.mjs scan",
    "verify:protection": "node scripts/verify-protection.mjs",
    "verify:production-db": "node scripts/verify-product.mjs --production-only",
    "verify:product-day": "node scripts/verify-product.mjs",
    "verify:cutover": "node scripts/verify-cutover.mjs",
    "verify:finance": "node scripts/verify-finance.mjs",
    "verify:reservations": "node scripts/verify-reservations.mjs",
    "verify:visual": "node scripts/verify-visual.mjs after"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
